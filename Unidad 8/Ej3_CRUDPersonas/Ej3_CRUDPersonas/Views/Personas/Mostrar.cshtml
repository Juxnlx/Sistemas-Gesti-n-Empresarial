@model List<Domain.DTOs.PersonaConNombreDepartamento>

    @{
    ViewData["Title"] = "Listado de Personas";
    }

    <h2>Listado de Personas</h2>

    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Apellidos</th>
                <th>Departamento</th>
                <th>Foto</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var persona in Model)
        {
            <tr>
                <td>@persona.persona.Nombre</td>
                <td>@persona.persona.Apellidos</td>
                <td>@persona.nombreDepartamento</td>
                <td>
                    <img src="@persona.persona.Foto" alt="Foto" width="50" height="50" />
                </td>
                <td>
                    <a asp-action="Details" asp-route-idPersona="@persona.persona.ID">Detalles</a> |
                    <a asp-action="Editar" asp-route-idPersona="@persona.persona.ID">Editar</a> |
                    <a asp-action="Eliminar" asp-route-idPersona="@persona.persona.ID">Eliminar</a>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <a asp-action="Crear" class="btn btn-primary">Crear Nueva Persona</a>
