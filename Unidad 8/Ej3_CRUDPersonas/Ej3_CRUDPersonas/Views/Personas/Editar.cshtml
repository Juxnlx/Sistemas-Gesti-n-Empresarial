@model Domain.DTOs.PersonaConListadoDepartamento

@{
    ViewData["Title"] = "Editar Persona";
}

<h2>Editar Persona</h2>

<form asp-action="Editar" method="post">
    <input type="hidden" asp-for="persona.ID" />

    <div class="form-group">
        <label>Nombre</label>
        <input asp-for="persona.Nombre" class="form-control" />
    </div>
    <div class="form-group">
        <label>Apellidos</label>
        <input asp-for="persona.Apellidos" class="form-control" />
    </div>
    <div class="form-group">
        <label>Teléfono</label>
        <input asp-for="persona.Telefono" class="form-control" />
    </div>
    <div class="form-group">
        <label>Dirección</label>
        <input asp-for="persona.Direccion" class="form-control" />
    </div>
    <div class="form-group">
        <label>Foto (URL)</label>
        <input asp-for="persona.Foto" class="form-control" />
    </div>
    <div class="form-group">
        <label>Fecha de Nacimiento</label>
        <input asp-for="persona.FechaNacimiento" type="date" class="form-control" />
    </div>
    <div class="form-group">
        <label>Departamento</label>
        <select asp-for="persona.IDDepartamento" class="form-control" asp-items="@(new SelectList(Model.listadoDepartamento, "ID", "nombre"))">
            <option value="">--Selecciona--</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
</form>
