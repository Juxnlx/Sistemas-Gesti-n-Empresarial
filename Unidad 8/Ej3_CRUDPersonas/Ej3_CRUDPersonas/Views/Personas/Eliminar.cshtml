@model Domain.Entities.Persona

@{
    ViewData["Title"] = "Eliminar Persona";
}

<h2>Eliminar Persona</h2>

<h4>¿Estás seguro de que quieres eliminar esta persona?</h4>
<div>
    <p><strong>Nombre:</strong> @Model.Nombre</p>
    <p><strong>Apellidos:</strong> @Model.Apellidos</p>
    <p><strong>Teléfono:</strong> @Model.Telefono</p>
    <p><strong>Dirección:</strong> @Model.Direccion</p>
    <p><strong>Departamento:</strong> @Model.IDDepartamento</p>
</div>

<form asp-action="EliminarPost" method="post">
    <input type="hidden" asp-for="ID" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Mostrar" class="btn btn-secondary">Cancelar</a>
</form>
