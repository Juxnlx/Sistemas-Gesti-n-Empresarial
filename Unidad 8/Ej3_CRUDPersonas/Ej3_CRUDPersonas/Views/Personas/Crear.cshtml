@model Domain.Entities.Persona

@{
    ViewData["Title"] = "Crear Persona";
}

<h2>Crear Persona</h2>

<form asp-action="Crear" method="post">
    <div class="form-group">
        <label>Nombre</label>
        <input asp-for="Nombre" class="form-control" />
    </div>
    <div class="form-group">
        <label>Apellidos</label>
        <input asp-for="Apellidos" class="form-control" />
    </div>
    <div class="form-group">
        <label>Teléfono</label>
        <input asp-for="Telefono" class="form-control" />
    </div>
    <div class="form-group">
        <label>Dirección</label>
        <input asp-for="Direccion" class="form-control" />
    </div>
    <div class="form-group">
        <label>Foto (URL)</label>
        <input asp-for="Foto" class="form-control" />
    </div>
    <div class="form-group">
        <label>Fecha de Nacimiento</label>
        <input asp-for="FechaNacimiento" type="date" class="form-control" />
    </div>
    <div class="form-group">
        <label>Departamento</label>
        <select asp-for="IDDepartamento" class="form-control" asp-items="@(new SelectList(ViewBag.ListadoDepartamentos, "ID", "nombre"))">
            <option value="">--Selecciona--</option>
        </select>
    </div>
    <button type="submit" class="btn btn-success">Crear</button>
</form>
